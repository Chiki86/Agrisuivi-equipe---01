{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Déboguer AgriSuivi : rapport",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/app.js",
      "args": ["rapport"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Déboguer le fichier de test ouvert",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "runtimeArgs": ["--test"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
